<div class="auth-container">
  <h2>Editar mi cuenta</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :name, "Nombre" %><br>
      <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
    </div>

    <div class="field">
      <%= f.label :email, "Correo electrónico" %><br>
      <%= f.email_field :email, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :city, "Ciudad (opcional)" %><br>
      <%= f.text_field :city %>
    </div>

    <div class="field">
      <%= f.label :bio, "Biografía (opcional)" %><br>
      <%= f.text_area :bio, rows: 3 %>
    </div>

    <div class="field">
      <%= f.label :avatar, "Foto de perfil (opcional)" %><br>
      <% if resource.avatar.attached? && resource.avatar.attachment.persisted? %>
        <%= image_tag resource.avatar, alt: "Foto actual", style: "max-width: 80px; border-radius: 50%;" %><br>
      <% end %>
      <%= f.file_field :avatar, accept: "image/*" %>
    </div>

    <div class="field">
      <%= f.label :password, "Nueva contraseña" %>
      <i>(déjala en blanco si no quieres cambiarla)</i><br>
      <%= f.password_field :password, autocomplete: "new-password" %>
      <% if @minimum_password_length %>
        <br><em>(mínimo <%= @minimum_password_length %> caracteres)</em>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirmar nueva contraseña" %><br>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :current_password, "Contraseña actual" %>
      <i>(la necesitamos para confirmar tus cambios)</i><br>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </div>

    <div class="actions">
      <%= f.submit "Guardar cambios" %>
    </div>
  <% end %>

  <h3>Eliminar mi cuenta</h3>
  <%= button_to "Eliminar mi cuenta", registration_path(resource_name),
                method: :delete,
                form: { data: { turbo_confirm: "¿Seguro? Esta acción no se puede deshacer." } } %>

  <p><%= link_to "← Volver a mi perfil", user_path(resource) %></p>
</div>