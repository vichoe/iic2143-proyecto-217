<p><%= link_to "← Volver a Mis solicitudes", exchange_requests_path %></p>

<h1>Calificar a <%= @exchange_request.other_participant(current_user).name %></h1>
<p>Intercambio por <strong><%= @exchange_request.book.title %></strong></p>

<%= form_with model: [@exchange_request, @review] do |f| %>
  <% if @review.errors.any? %>
    <ul>
      <% @review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <fieldset class="rating-field">
    <legend>Puntuación</legend>

    <p id="rating-help">
      Elige entre 1 y 5 estrellas.
    </p>

    <div class="rating-stars">
      <% 5.downto(1) do |number| %>
        <%= f.radio_button :score,
                          number,
                          required: true,
                          class: "rating-input",
                          aria: { describedby: "rating-help" } %>

        <%= f.label :"score_#{number}", class: "rating-star" do %>
          <span aria-hidden="true">★</span>
          <span class="rating-sr-only">
            <%= number %> <%= number == 1 ? "estrella" : "estrellas" %>
          </span>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <p>
    <%= f.label :comment, "Comentario (opcional)" %><br>
    <%= f.text_area :comment, rows: 4, maxlength: 1000 %>
  </p>

  <%= f.submit "Enviar calificación" %>
<% end %>