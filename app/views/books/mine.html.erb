<section class="my-publications">
  <div class="catalog-heading">
    <p class="catalog-eyebrow">TU ESPACIO EN BOOK RACK</p>
    <h1>Mis publicaciones</h1>
    <p>Aquí puedes consultar y administrar tus libros publicados.</p>

    <%= link_to "Publicar un libro",
                new_book_path,
                class: "catalog-explore" %>
  </div>

  <% if @books.any? %>
    <ul class="bookshelf">
      <% @books.each do |book| %>
        <li class="shelf-slot">
          <article class="shelf-book">
            <%= link_to book_path(book),
                        class: "book-cover-link",
                        aria: { label: "Ver #{book.title}" } do %>
              <% if book.cover_image.attached? %>
                <%= image_tag book.cover_image,
                              alt: "",
                              loading: "lazy",
                              class: "book-cover-image" %>
              <% else %>
                <div class="book-cover-placeholder" aria-hidden="true">
                  <span>BOOK RACK</span>
                  <strong><%= book.title %></strong>
                  <span><%= book.author %></span>
                </div>
              <% end %>
            <% end %>

            <div class="book-information">
              <span class="book-modality">
                <%= book.exchange? ? "Intercambio" : "Préstamo" %>
              </span>

              <span class="book-owned">
                <%= {
                  "available" => "Disponible",
                  "reserved" => "Reservado",
                  "exchanged" => "Intercambiado"
                }.fetch(book.status, book.status.humanize) %>
              </span>

              <h3><%= link_to book.title, book_path(book) %></h3>
              <p class="book-author"><%= book.author %></p>

              <div class="publication-actions">
                <%= link_to "Editar", edit_book_path(book) %>

                <%= button_to "Eliminar",
                              book_path(book),
                              method: :delete,
                              form: {
                                data: {
                                  turbo_confirm: "¿Quieres retirar esta publicación?"
                                }
                              } %>
              </div>
            </div>
          </article>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="catalog-empty">
      <h2>Todavía no tienes publicaciones</h2>
      <p>Publica tu primer libro para compartirlo con la comunidad.</p>
    </div>
  <% end %>
</section>