<%= form_with model: book, data: { controller: "loan-dates" } do |f| %>
  <% if book.errors.any? %>
    <div style="color: red;">
      <p>No se pudo guardar el libro:</p>
      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= f.label :title, "Título" %><br>
    <%= f.text_field :title, required: true %>
  </p>

  <p>
    <%= f.label :author, "Autor" %><br>
    <%= f.text_field :author, required: true %>
  </p>

  <p>
    <%= f.label :category_id, "Categoria" %><br>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name,
                            { prompt: "Elige una categoría" }, required: true %>
  </p>

  <p>
    <%= f.label :condition, "Estado del libro" %><br>
    <%= f.select :condition, condition_options, { prompt: "Elige el estado" }, required: true %>
  </p>

  <p>
    <%= f.label :modality, "Modalidad" %><br>
    <%= f.select :modality, modality_options, {}, 
    data: { loan_dates_target: "modality", action: "change->loan-dates#toggle" } %>
  </p>

  <%# El fieldset va fuera del <p>: un <p> no puede contener elementos de bloque, %>
  <%# el navegador lo cerraria antes y quedaría HTML inválido %>

  <fieldset data-loan-dates-target="dates">
    <legend>Disponibilidad (solo para préstamos)</legend>
    <p>
      <%= f.label :available_from, "Disponible desde" %><br>
      <%= f.date_field :available_from %>
    </p>
    <p>
      <%= f.label :available_until, "Disponible hasta" %><br>
      <%= f.date_field :available_until %>
    </p>
  </fieldset>

  <p>
    <%= f.label :description, "Descripción (opcional)" %><br>
    <%= f.text_area :description, rows: 4 %>
  </p>

  <p>
    <%= f.label :publisher, "Editorial (opcional)" %><br>
    <%= f.text_field :publisher %>
  </p>

  <p>
    <%= f.label :published_year, "Año de publicación (opcional)" %><br>
    <%= f.number_field :published_year, min: 1, max: Date.current.year, step: 1 %>

  <p>
    <%= f.label :language, "Idioma (opcional)" %><br>
    <%= f.select :language, language_options, include_blank: "Sin especificar" %>  </p>

  <p>
    <%= f.label :cover_image, book.new_record? ? "Foto del libro" : "Cambiar foto del libro (opcional)" %><br>
    <%= f.file_field :cover_image, accept: "image/*", required: book.new_record? %>
  </p>

  <p>
    <%= f.label :photos, book.new_record? ? "Mas fotos (opcional)" : "Reemplazar las otras fotos (opcional)" %><br>
    <%= f.file_field :photos, accept: "image/*", multiple: true %>
  </p>

  <%= f.submit submit_label %>
<% end %>