<div class="page-container">

  <div class="top-bar">
    <% if user_signed_in? %>
      <%= link_to user_path(current_user) do %>
        <%= avatar_for(current_user) %>
        Hola, <%= current_user.name %>
      <% end %>

      <%= link_to "Publicar libro", new_book_path %>
      <%= link_to "Mis solicitudes", exchange_requests_path %>
      <% if current_user.admin? %>
        <%= link_to "Administrar usuarios", users_path %>
      <% end %>

      <%= button_to "Cerrar sesión",
                    destroy_user_session_path,
                    method: :delete %>
    <% else %>
      <%= link_to "Iniciar sesión / Registrarse",
                  new_user_session_path %>
    <% end %>
  </div>


  <div class="search">
    <%= form_with url: root_path, method: :get do |f| %>
      <%= f.search_field :q, value: @query, placeholder: "Buscar libros por título o autor..." %>
      <%= f.submit "Buscar libros", name: nil %>
    <% end %>

    <% if can_search_users? %>
      <%= form_with url: root_path, method: :get do |f| %>
        <%= f.search_field :user_q, value: @user_query, placeholder: "Buscar usuarios por nombre..." %>
        <%= f.submit "Buscar usuarios", name: nil %>
      <% end %>
    <% end %>
  </div>


  <% filters_applied = @filters.values.any?(&:present?) %>

  <div class="filters">
    <%= form_with url: root_path, method: :get do %>
      <%= hidden_field_tag :q, @query if @query.present? %>

      <%= select_tag :category_id,
                     options_for_select(
                       Category.order(:name).pluck(:name, :id),
                       @filters[:category_id]
                     ),
                     include_blank: "Categoría" %>

      <%= select_tag :condition,
                     options_for_select(
                       condition_options,
                       @filters[:condition]
                     ),
                     include_blank: "Estado" %>

      <%= select_tag :modality,
                     options_for_select(
                       modality_options,
                       @filters[:modality]
                     ),
                     include_blank: "Modalidad" %>

      <%= select_tag :status,
                     options_for_select(
                       status_filter_options,
                       @filters[:status]
                     ),
                     include_blank: "Disponibilidad" %>

      <%= text_field_tag :publisher, @filters[:publisher], placeholder: "Editorial" %>

      <%= number_field_tag :year_from, @filters[:year_from],
                           placeholder: "Año desde", min: 0, max: Date.current.year %>
      <%= number_field_tag :year_to, @filters[:year_to],
                           placeholder: "Año hasta", min: 0, max: Date.current.year %>

      <%= select_tag :language,
                     options_for_select(language_options, @filters[:language]),
                     include_blank: "Idioma" %>
                     
      <%= select_tag :sort,
                     options_for_select(sort_options, @sort),
                     include_blank: "Ordenar por",
                     disabled: @books.empty?,
                     onchange: "this.form.requestSubmit()" %>

      <%= submit_tag "Filtrar" %>

      <% if filters_applied %>
        <%= link_to "Limpiar filtros",
                    root_path(q: @query.presence) %>
      <% end %>
    <% end %>
  </div>


  <% if @user_query.present? && can_search_users? %>
    <div class="results">
      <h2>Usuarios que coinciden con "<%= @user_query %>"</h2>
      <p><%= link_to "limpiar búsqueda de usuarios", root_path %></p>

      <% if @users.any? %>
        <ul>
          <% @users.each do |user| %>
            <li>
              <%= link_to user_path(user) do %>
                <%= avatar_for(user, size: 24) %>
                <%= user.name %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No encontramos usuarios con ese nombre.</p>
      <% end %>
    </div>
  <% end %>

  <div class="results">
    <% if @query.present? %>
      <p>
        Resultados para "<%= @query %>"
        (<%= link_to "limpiar búsqueda", root_path %>)
      </p>
      <h2>Libros</h2>
    <% elsif filters_applied %>
      <h2>Resultados filtrados</h2>
    <% else %>
      <h2>Publicaciones recientes</h2>
    <% end %>

    <% if @books.any? %>
      <ul>
        <% @books.each do |book| %>
          <li>
            <% if book.cover_image.attached? %>
              <%= image_tag book.cover_image,
                            alt: book.title,
                            style: "max-width: 50px; vertical-align: middle;" %>
            <% end %>

            <%= link_to book.title, book_path(book) %>
            de <%= book.author %>
            · publicado por
            <%= can_view_profile?(book.user) ? link_to(book.user.name, user_path(book.user)) : book.user.name %>
          </li>
        <% end %>
      </ul>
    <% elsif @query.present? %>
      <p>No encontramos libros que coincidan con tu búsqueda.</p>
    <% elsif filters_applied %>
      <p>No hay libros que coincidan con los filtros aplicados.</p>
    <% else %>
      <p>Todavía no hay libros publicados.</p>
    <% end %>
  </div>

</div>