<style>
  .top-bar {
    display: flex;
    justify-content: flex-end;
    padding: 1rem;
  }

  .search {
    display: flex;
    justify-content: center;
    margin-top: 25vh;
  }
</style>

<div class="top-bar">
  <% if user_signed_in? %>
    Hola, <%= current_user.name %>
    <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete %>
  <% else %>
    <%= link_to "Iniciar sesión / Registrarse", new_user_session_path %>
  <% end %>
</div>

<div class="search">
  <%= form_with url: root_path, method: :get do |f| %>
    <%= f.search_field :q, placeholder: "Buscar libros..." %>
    <%= f.submit "Buscar", name: nil %>
  <% end %>
</div>