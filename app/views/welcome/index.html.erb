<div class="page-container catalog-page">
  <section class="catalog-hero">
    <p class="catalog-eyebrow">UN LIBRO, UNA NUEVA HISTORIA</p>
    <h1>Tu próxima lectura<br>está en este librero.</h1>
    <p>Descubre, intercambia y comparte libros con nuestra comunidad.</p>
    <a href="#catalog-books" class="catalog-explore">Explorar libros ↓</a>
  </section>



  <div class="search">
    <%= form_with url: root_path, method: :get do |f| %>
      <%= f.search_field :q,
                        value: @query,
                        placeholder: "Buscar libros por título o autor..." %>

      <%= f.submit "Buscar libros", name: nil %>

      <% if @query.present? %>
        <%= link_to "Limpiar búsqueda",
                    root_path,
                    class: "clear-search" %>
      <% end %>
    <% end %>

    <% if can_search_users? %>
      <%= form_with url: root_path, method: :get do |f| %>
        <%= f.search_field :user_q,
                          value: @user_query,
                          placeholder: "Buscar usuarios por nombre..." %>

        <%= f.submit "Buscar usuarios", name: nil %>
      <% end %>
    <% end %>
  </div>


  <% filters_applied = @filters.values.any?(&:present?) %>

  <div class="filters">
    <%= form_with url: root_path, method: :get do %>
      <%= hidden_field_tag :q, @query if @query.present? %>

      <%= select_tag :category_id,
                     options_for_select(
                       Category.order(:name).pluck(:name, :id),
                       @filters[:category_id]
                     ),
                     include_blank: "Categoría" %>

      <%= select_tag :condition,
                     options_for_select(
                       condition_options,
                       @filters[:condition]
                     ),
                     include_blank: "Estado" %>

      <%= select_tag :modality,
                     options_for_select(
                       modality_options,
                       @filters[:modality]
                     ),
                     include_blank: "Modalidad" %>

      <%= select_tag :status,
                     options_for_select(
                       status_filter_options,
                       @filters[:status]
                     ),
                     include_blank: "Disponibilidad" %>

      <%= text_field_tag :publisher, @filters[:publisher], placeholder: "Editorial" %>

      <%= number_field_tag :year_from, @filters[:year_from],
                           placeholder: "Año desde", min: 1, max: Date.current.year %>
      <%= number_field_tag :year_to, @filters[:year_to],
                           placeholder: "Año hasta", min: 0, max: Date.current.year %>

      <%= select_tag :language,
                     options_for_select(language_options, @filters[:language]),
                     include_blank: "Idioma" %>
                     
      <%= select_tag :sort,
                     options_for_select(sort_options, @sort),
                     include_blank: "Ordenar por",
                     disabled: @books.empty?,
                     onchange: "this.form.requestSubmit()" %>

      <%= submit_tag "Filtrar" %>

      <% if filters_applied %>
        <%= link_to "Limpiar filtros",
                    root_path(q: @query.presence) %>
      <% end %>
    <% end %>
  </div>


  <% if @user_query.present? && can_search_users? %>
    <div class="results">
      <h2>Usuarios que coinciden con "<%= @user_query %>"</h2>
      <p><%= link_to "limpiar búsqueda de usuarios", root_path %></p>

      <% if @users.any? %>
        <ul>
          <% @users.each do |user| %>
            <li>
              <%= link_to user_path(user) do %>
                <%= avatar_for(user, size: 24) %>
                <%= user.name %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No encontramos usuarios con ese nombre.</p>
      <% end %>
    </div>
  <% end %>

    <section class="catalog-results" id="catalog-books">
    <div class="catalog-heading">
      <div>
        <p class="catalog-eyebrow">EL LIBRERO DE LA COMUNIDAD</p>

        <% if @query.present? %>
          <h2>Resultados para “<%= @query %>”</h2>
        <% elsif filters_applied %>
          <h2>Tu selección de libros</h2>
        <% else %>
          <h2>Historias esperando un nuevo lector</h2>
        <% end %>
      </div>
    </div>

    <% if @books.any? %>
      <ul class="bookshelf">
        <% @books.each do |book| %>
          <li class="shelf-slot">
            <article class="shelf-book">
              <%= link_to book_path(book),
                          class: "book-cover-link",
                          aria: { label: "Ver #{book.title}" } do %>
                <% if book.cover_image.attached? %>
                  <%= image_tag book.cover_image,
                                alt: "",
                                loading: "lazy",
                                class: "book-cover-image" %>
                <% else %>
                  <div class="book-cover-placeholder" aria-hidden="true">
                    <span>ENTRE LIBROS</span>
                    <strong><%= book.title %></strong>
                    <span><%= book.author %></span>
                  </div>
                <% end %>
              <% end %>

              <div class="book-information">
                <span class="book-modality">
                  <%= book.exchange? ? "Intercambio" : "Préstamo" %>
                </span>

                <% if user_signed_in? && book.user_id == current_user.id %>
                  <span class="book-owned">Tu publicación</span>
                <% end %>

                <h3><%= link_to book.title, book_path(book) %></h3>
                <p class="book-author"><%= book.author %></p>

                <p class="book-owner">
                  Publicado por
                  <% if can_view_profile?(book.user) %>
                    <%= link_to book.user.name, user_path(book.user) %>
                  <% else %>
                    <%= book.user.name %>
                  <% end %>
                </p>
              </div>
            </article>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="catalog-empty">
        <h3>Este estante está esperando historias</h3>

        <% if @query.present? %>
          <p>No encontramos libros que coincidan con tu búsqueda.</p>
          <%= link_to "Volver al catálogo", root_path %>
        <% elsif filters_applied %>
          <p>No hay libros que coincidan con los filtros aplicados.</p>
          <%= link_to "Volver al catálogo", root_path %>
        <% else %>
          <p>Todavía no hay libros publicados.</p>
          <%= link_to "Publicar un libro", new_book_path %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>