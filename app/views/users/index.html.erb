
<h1>Administración de Usuarios</h1>

<h2>Buscar usuarios</h2>
<%= form_with url: users_path, method: :get do |f| %>
  <%= f.search_field :q,
      value: @query,
      placeholder: "Buscar usuario por nombre..." %>

  <%= f.submit "Buscar" %>
<% end %>
<hr>

<h2>Usuarios registrados</h2>
<p>Total encontrados: <%= @users.count %></p>

<% if @users.any? %>
  <table>
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Correo</th>
        <th>Rol</th>
        <th>Calificación</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>

    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td>
            <%= user.admin? ? "Administrador" : "Usuario" %>
          </td>
          <td>
            <%= user.average_rating || "Sin calificación" %>
          </td>
          <td>
            <%= user.suspended? ? "Suspendido" : "Activo" %>
          </td>

          <td>
            <%= link_to "Ver perfil", user_path(user) %>

            <% unless user == current_user %>
              <% if user.suspended? %>
                <%= button_to "Reactivar",
                              reactivate_user_path(user),
                              method: :patch %>
              <% else %>
                <%= form_with url: suspend_user_path(user),
                              method: :patch do |f| %>

                  <%= f.text_area :suspended_reason,
                                  rows: 2,
                                  maxlength: 1000,
                                  placeholder: "Motivo de suspensión (opcional)" %>

                  <%= f.submit "Suspender",
                              data: {
                                turbo_confirm: "¿Quieres suspender a este usuario?"
                              } %>
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No se encontraron usuarios.</p>
<% end %>
