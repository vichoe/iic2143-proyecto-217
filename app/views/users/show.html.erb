

<h1><%= avatar_for(@user, size: 64) %> <%= @user.name %></h1>

<% if current_user == @user %>
  <p><em>Este es tu perfil público. Así lo ven los demás.</em></p>
  <p><%= link_to "Editar perfil", edit_user_registration_path, class: "profile-edit-button" %></p>
<% end %>

<% if @user.city.present? %>
  <p><strong>Ciudad:</strong> <%= @user.city %></p>
<% end %>

<% if @user.bio.present? %>
  <div class="user-bio"><%= simple_format @user.bio %></div>
<% end %>

<h2>Reputación</h2>
<% if @user.average_rating %>
  <p>
    <%= "★" * @user.average_rating.round %><%= "☆" * (5 - @user.average_rating.round) %>
    <%= @user.average_rating %> / 5 (<%= @user.received_reviews.count %> reseñas)
  </p>
<% else %>
  <p>Todavía no tiene reseñas.</p>
<% end %>

<% if @received_reviews.any? %>
  <h3>Comentarios recibidos</h3>

  <ul>
    <% @received_reviews.each do |review| %>
      <li>
        <strong><%= review.reviewer.name %></strong>
        · <%= "★" * review.score %><%= "☆" * (5 - review.score) %>

        <% if review.comment.present? %>
          <p><%= simple_format review.comment %></p>
        <% else %>
          <p><em>Sin comentario.</em></p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<h2>Publicaciones vigentes</h2>
<% if @books.any? %>
  <ul>
    <% @books.each do |book| %>
      <li>
        <% if book.cover_image.attached? %>
          <%= image_tag book.cover_image, alt: book.title, style: "max-width: 50px; vertical-align: middle;" %>
        <% end %>
        <%= link_to book.title, book_path(book) %> de <%= book.author %> (<%= status_label(book) %>)
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No tiene publicaciones vigentes.</p>
<% end %>


<h2>Historial de transacciones exitosas</h2>
<% if @completed_requests.any? %>
  <ul id="historial">
    <% @completed_requests.each do |request| %>
      <li>
        <%= link_to request.book.title, book_path(request.book) %>
        de <%= request.book.author %>
        · <%= modality_label(request.book) %>
        <% if request.completed_at %>
          · concluido el <%= request.completed_at.strftime("%d/%m/%Y") %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Todavía no tiene transacciones.</p>
<% end %>